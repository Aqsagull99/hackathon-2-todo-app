# Kubernetes Secrets Template for Phase IV
# Copy this file to secrets.yaml and fill in your actual values
# NEVER commit secrets.yaml to Git!
#
# Usage:
#   1. Copy: cp secrets.yaml.example secrets.yaml
#   2. Fill in real values (replace all <PLACEHOLDER> values)
#   3. Apply: kubectl apply -f secrets.yaml

apiVersion: v1
kind: Secret
metadata:
  name: neon-db-secret
  namespace: default
type: Opaque
data:
  # Dapr format database URL (postgres://)
  # Generate with: echo -n "postgres://username:password@host/database?sslmode=require" | base64
  dapr-db-url: <BASE64_ENCODED_POSTGRES_URL>

  # Backend format database URL (postgresql+asyncpg://)
  # Generate with: echo -n "postgresql+asyncpg://username:password@host/database?ssl=require" | base64
  backend-db-url: <BASE64_ENCODED_ASYNCPG_URL>

---
apiVersion: v1
kind: Secret
metadata:
  name: auth-secret
  namespace: default
type: Opaque
data:
  # JWT secret for authentication
  # Generate with: echo -n "your-secret-key-here" | base64
  jwt-secret: <BASE64_ENCODED_JWT_SECRET>

---
# Instructions for generating base64 values:
#
# Database URL (Dapr format):
#   echo -n "postgres://user:pass@host/db?sslmode=require" | base64
#
# Database URL (Backend format):
#   echo -n "postgresql+asyncpg://user:pass@host/db?ssl=require" | base64
#
# JWT Secret:
#   # Generate random secret
#   openssl rand -base64 32
#   # Then encode it
#   echo -n "your-generated-secret" | base64
#
# To decode and verify:
#   echo "BASE64_STRING" | base64 -d
