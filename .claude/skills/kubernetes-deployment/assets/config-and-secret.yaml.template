# Combined ConfigMap and Secret Example Template
# Demonstrates proper usage of both ConfigMaps and Secrets in a single deployment

---
# ConfigMap for non-sensitive configuration
apiVersion: v1
kind: ConfigMap
metadata:
  name: app-config
  namespace: PLACEHOLDER_NAMESPACE
  labels:
    app: PLACEHOLDER_APP_NAME
    environment: PLACEHOLDER_ENVIRONMENT
  annotations:
    description: "Application configuration for PLACEHOLDER_APP_NAME"
data:
  # Non-sensitive configuration
  LOG_LEVEL: "info"
  DEBUG_MODE: "false"
  API_TIMEOUT: "30s"
  DATABASE_HOST: "db.example.com"
  DATABASE_PORT: "5432"
  FEATURE_FLAGS: "feature1=true,feature2=false"
  MAX_CONNECTIONS: "100"
  CACHE_TTL: "300"
---
# Secret for sensitive configuration
apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  namespace: PLACEHOLDER_NAMESPACE
  labels:
    app: PLACEHOLDER_APP_NAME
    environment: PLACEHOLDER_ENVIRONMENT
    security-level: high
  annotations:
    description: "Sensitive configuration for PLACEHOLDER_APP_NAME"
    security.classification: "confidential"
type: Opaque
data:
  # Base64 encoded sensitive values
  DATABASE_PASSWORD: "PLACEHOLDER_BASE64_ENCODED_DB_PASSWORD"
  API_KEY: "PLACEHOLDER_BASE64_ENCODED_API_KEY"
  JWT_SECRET: "PLACEHOLDER_BASE64_ENCODED_JWT_SECRET"
  ENCRYPTION_KEY: "PLACEHOLDER_BASE64_ENCODED_ENCRYPTION_KEY"
---
# Deployment using both ConfigMap and Secret
apiVersion: apps/v1
kind: Deployment
metadata:
  name: combined-config-deployment
  namespace: PLACEHOLDER_NAMESPACE
  labels:
    app: PLACEHOLDER_APP_NAME
spec:
  replicas: 3
  selector:
    matchLabels:
      app: PLACEHOLDER_APP_NAME
  template:
    metadata:
      labels:
        app: PLACEHOLDER_APP_NAME
    spec:
      containers:
      - name: app
        image: my-app:latest
        # Inject all ConfigMap values as environment variables (safe for non-sensitive data)
        envFrom:
        - configMapRef:
            name: app-config
        # Inject specific Secret values as environment variables (use with caution)
        env:
        - name: DATABASE_PASSWORD
          valueFrom:
            secretKeyRef:
              name: app-secrets
              key: DATABASE_PASSWORD
        - name: API_KEY
          valueFrom:
            secretKeyRef:
              name: app-secrets
              key: API_KEY
        # Mount ConfigMap as volume for configuration files
        volumeMounts:
        - name: config-volume
          mountPath: /etc/config
          readOnly: true
        # Mount Secrets as volume (recommended approach for sensitive data)
        - name: secrets-volume
          mountPath: /etc/secrets
          readOnly: true
        # Health checks
        livenessProbe:
          httpGet:
            path: /healthz
            port: 8080
          initialDelaySeconds: 30
          periodSeconds: 10
        readinessProbe:
          httpGet:
            path: /readyz
            port: 8080
          initialDelaySeconds: 5
          periodSeconds: 5
        # Resource limits
        resources:
          requests:
            memory: "256Mi"
            cpu: "250m"
          limits:
            memory: "512Mi"
            cpu: "500m"
      volumes:
      - name: config-volume
        configMap:
          name: app-config
          # Optional: specify specific keys to mount
          items:
          - key: "application.properties"
            path: "app.properties"
      - name: secrets-volume
        secret:
          secretName: app-secrets
          # Set restrictive permissions
          defaultMode: 256  # 0400 in octal - readable only by owner
          # Optional: specify specific keys to mount
          items:
          - key: "JWT_SECRET"
            path: "jwt-secret"
            mode: 256  # 0400 in octal