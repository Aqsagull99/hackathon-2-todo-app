# Kubernetes Secret Template
# Use this template to define sensitive configuration data for your applications
# NOTE: Values should be base64 encoded before applying

apiVersion: v1
kind: Secret
metadata:
  name: PLACEHOLDER_SECRET_NAME
  namespace: PLACEHOLDER_NAMESPACE
  labels:
    app: PLACEHOLDER_APP_NAME
    environment: PLACEHOLDER_ENVIRONMENT
    security-level: high
  annotations:
    description: "Sensitive configuration for PLACEHOLDER_APP_NAME"
    security.classification: "confidential"
type: Opaque
data:
  # Base64 encoded values
  # Example: echo -n "my-secret-value" | base64
  DATABASE_PASSWORD: "PLACEHOLDER_BASE64_ENCODED_DB_PASSWORD"
  API_KEY: "PLACEHOLDER_BASE64_ENCODED_API_KEY"
  JWT_SECRET: "PLACEHOLDER_BASE64_ENCODED_JWT_SECRET"
  ENCRYPTION_KEY: "PLACEHOLDER_BASE64_ENCODED_ENCRYPTION_KEY"
  AWS_ACCESS_KEY_ID: "PLACEHOLDER_BASE64_ENCODED_AWS_ACCESS_KEY"
  AWS_SECRET_ACCESS_KEY: "PLACEHOLDER_BASE64_ENCODED_AWS_SECRET_KEY"
---
# Example of using Secret in a Pod with different injection methods
apiVersion: v1
kind: Pod
metadata:
  name: secret-example-pod
  namespace: PLACEHOLDER_NAMESPACE
spec:
  containers:
  - name: app
    image: my-app:latest
    # Method 1: Inject all Secret values as environment variables (NOT RECOMMENDED for sensitive data)
    envFrom:
    - secretRef:
        name: PLACEHOLDER_SECRET_NAME
    # Method 2: Inject specific values (USE WITH CAUTION)
    env:
    - name: DB_PASSWORD
      valueFrom:
        secretKeyRef:
          name: PLACEHOLDER_SECRET_NAME
          key: DATABASE_PASSWORD
    # Method 3: Mount as volume (RECOMMENDED approach)
    volumeMounts:
    - name: secrets-volume
      mountPath: /etc/secrets
      readOnly: true
    # Mount specific items with custom paths and permissions
    - name: tls-certs
      mountPath: /etc/tls
      readOnly: true
  volumes:
  - name: secrets-volume
    secret:
      secretName: PLACEHOLDER_SECRET_NAME
      defaultMode: 256  # 0400 in octal - readable only by owner
  - name: tls-certs
    secret:
      secretName: PLACEHOLDER_SECRET_NAME
      items:
      - key: "tls.crt"
        path: "certificate.pem"
        mode: 256  # 0400 in octal
      - key: "tls.key"
        path: "private-key.pem"
        mode: 256  # 0400 in octal